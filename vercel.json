{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/uploads/:path*", "destination": "/api/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
